# Copy this file to .env (same folder as manage.py) and fill in. Never commit .env.

# --- AI receipt reading ---
# Cheapest: OpenAI GPT-6 Luna
AI_PROVIDER=openai
OPENAI_API_KEY=
# Leave blank for the default (gpt-6-luna). gpt-6-sol is ~20x pricier but stronger on messy handwriting.
AI_MODEL=
AI_REASONING_EFFORT=low
# Read bills/receipts/quotes automatically on upload (1) or only via the button (0)
AI_AUTO_READ=1

# Alternative: Claude
# AI_PROVIDER=anthropic
# ANTHROPIC_API_KEY=

# Alternative: a model on your own server (llama.cpp, Ollama or vLLM – OpenAI-compatible)
#   llama-server -m qwen2.5-vl-7b-instruct-q4_k_m.gguf --mmproj mmproj.gguf --port 8080
# AI_PROVIDER=local
# AI_BASE_URL=http://127.0.0.1:8080/v1
# AI_MODEL=qwen2.5-vl-7b

# --- Files ---
# database = keep uploads in Postgres (hosts that wipe the disk on redeploy)
FILE_STORAGE=filesystem

# --- Django ---
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=1

# --- Email notifications and client reports ---
# simulated = nothing is sent; messages appear in the in-app Inbox (good for demos)
# outlook   = Microsoft Graph sendMail from a shared mailbox (Entra ID app with Mail.Send)
# smtp      = any SMTP server, e.g. Gmail / Google Workspace
EMAIL_PROVIDER=simulated
SITE_URL=http://127.0.0.1:8000
EMAIL_ORG_NAME=Campaign Finance
REPORT_AGENCY_NAME=Your Agency (Pvt) Ltd
# Outlook (Microsoft 365):
# MS_GRAPH_TENANT_ID=
# MS_GRAPH_CLIENT_ID=
# MS_GRAPH_CLIENT_SECRET=
# MS_GRAPH_SENDER=finance@youragency.lk
# SMTP:
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# DEFAULT_FROM_EMAIL=
